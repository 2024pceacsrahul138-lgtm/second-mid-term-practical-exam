<!DOCTYPE html>
<html>
<head>
    <title>Shopping Cart</title>
    <style>
        body {
            font-family: Arial;
            background: #f2f2f2;
            padding: 30px;
        }

        .container {
            background: white;
            padding: 25px;
            max-width: 650px;
            margin: auto;
            border-radius: 10px;
        }

        h2 {
            text-align: center;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th, td {
            padding: 12px;
            border-bottom: 1px solid #ddd;
            text-align: center;
        }

        button {
            padding: 6px 12px;
            cursor: pointer;
            background: #333;
            color: white;
            border: none;
            border-radius: 4px;
        }

        .summary {
            text-align: right;
            margin-top: 20px;
            line-height: 2;
        }
    </style>
</head>
<body>

<div class="container">
    <h2>Shopping Cart</h2>

    <table>
        <thead>
            <tr>
                <th>Item</th>
                <th>Price</th>
                <th>Qty</th>
                <th>Total</th>
                <th>Action</th>
            </tr>
        </thead>

        <tbody id="cart"></tbody>
    </table>

    <div class="summary" id="summary"></div>
</div>

<script>

let items = [
    {name: "Notebook", price: 120, qty: 1},
    {name: "Pen Pack", price: 80, qty: 1},
    {name: "Water Bottle", price: 350, qty: 1}
];

function displayCart() {

    let cart = document.getElementById("cart");
    let summary = document.getElementById("summary");

    cart.innerHTML = "";

    if (items.length === 0) {
        summary.innerHTML = "<h3>Your cart is empty!</h3>";
        return;
    }

    let subtotal = 0;

    items.forEach((item, index) => {

        let total = item.price * item.qty;
        subtotal += total;

        cart.innerHTML += `
            <tr>
                <td>${item.name}</td>
                <td>Rs. ${item.price}</td>
                <td>
                    <button onclick="changeQty(${index}, -1)">-</button>
                    ${item.qty}
                    <button onclick="changeQty(${index}, 1)">+</button>
                </td>
                <td>Rs. ${total}</td>
                <td>
                    <button onclick="removeItem(${index})">Remove</button>
                </td>
            </tr>
        `;
    });

    let discount = subtotal >= 1000 ? subtotal * 0.10 : 0;
    let payable = subtotal - discount;

    summary.innerHTML = `
        Subtotal: Rs. ${subtotal.toFixed(2)}<br>
        Discount (10%): Rs. ${discount.toFixed(2)}<br>
        <h3>Amount Payable: Rs. ${payable.toFixed(2)}</h3>
    `;
}

function changeQty(index, value) {

    if (items[index].qty + value >= 1) {
        items[index].qty += value;
    }

    displayCart();
}

function removeItem(index) {
    items.splice(index, 1);
    displayCart();
}

displayCart();

</script>

</body>
</html>




 